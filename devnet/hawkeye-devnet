    def logs(self, lines, follow):
        self.load()
        files = [self.path("miner.log"), self.s["anvil"]["log"], self.path("forge-deploy.log")]
        files += [os.path.join(n["datadir"], "regtest", "debug.log") for n in self.s["nodes"]]
        files += [a["log"] for a in self.s.get("attestors", [])]
        files = [f for f in files if os.path.exists(f)]
        if follow:
            os.execvp("tail", ["tail", "-n", str(lines), "-F"] + files)
        for f in files:
            print("==> %s <==" % f)
            with open(f, errors="replace") as fh:
                print("".join(fh.readlines()[-lines:]), end="")

    def down(self, quiet=False):
        self.load()
        stopped = []
        for label, pid, match in self.processes():
            if not proc_alive(pid, match):
                continue
            if label.startswith("ycashd"):
                i = int(label[len("ycashd"):])
                try:
                    self.node(i, 30).stop()
                except Exception:
                    pass
                deadline = time.time() + 60
                while time.time() < deadline and proc_alive(pid):
                    time.sleep(0.2)
            stop_group(pid, match)
            stopped.append(label)
        for a in self.s.get("attestors", []):
            a["pid"] = None
        if self.s.get("miner"):
            self.s["miner"]["pid"] = None
        if self.s.get("anvil"):
            self.s["anvil"]["pid"] = None
        for n in self.s.get("nodes", []):
            n["pid"] = None
        self.save()
        left = self.running()
        if left:
            die("still running after down: %s" % left)
        if not quiet:
            self.say("devnet down (stopped: %s); the directory %s is kept (`up` resumes, `clean` removes it)"
                     % (", ".join(stopped) or "nothing was running", self.dir))

    def clean(self):
        if self.load(required=False) is not None:
            alive = self.running()
            if alive:
                die("the devnet is up (%s); `hawkeye-devnet down` first" % alive)
        if os.path.isdir(self.dir):
            if not os.path.exists(self.state_path) and os.listdir(self.dir):
                die("%s has no devnet.json; refusing to remove a directory this script did not create" % self.dir)
            shutil.rmtree(self.dir)
        self.say("removed %s" % self.dir)

    # ================================================================ scenario demo
    def wait_for(self, what, predicate, timeout, poll=1.0):
        t0 = time.time()
        last_error = None
        while time.time() - t0 < timeout:
            try:
                r = predicate()
                if r:
                    self.say("  ok: %s (%.0fs, height %d)" % (what, time.time() - t0, self.tip()))
                    return r
            except DevnetError:
                raise
            except Exception as error:
                last_error = error
            time.sleep(poll)
        die("timed out after %ds waiting for: %s%s" % (timeout, what, " (last error: %s)" % last_error if last_error else ""))

    def intents(self):
        return self.node(0).vault_list({"tag": "WYEC", "setid": self.s["set"]["setid"], "kind": "intent"})

    def memo_of(self, txid):
        tx = self.node(0).getrawtransaction(txid, 1)
        for o in tx["vout"]:
            m = decode_memo(o["scriptPubKey"]["hex"])
            if m:
                return m
        return None

    def spender_of(self, outpoint, from_height):
        """The confirmed or mempool transaction spending `outpoint` (txid, decoded tx) or None."""
        txid, n = outpoint.split(":")
        n0 = self.node(0)
        cands = list(n0.getrawmempool())
        for h in range(from_height, n0.getblockcount() + 1):
            cands += n0.getblock(n0.getblockhash(h))["tx"]
        for t in cands:
            tx = n0.getrawtransaction(t, 1)
            for i in tx["vin"]:
                if i.get("txid") == txid and i.get("vout") == int(n):
                    return t, tx
        return None

    def owner_of_inputs(self, tx):
        """Which attestor's wallet funded `tx` (its non-template inputs)."""
        owners = set()
        for i in tx["vin"]:
            if "txid" not in i:
                continue
            prev = self.node(0).getrawtransaction(i["txid"], 1)["vout"][i["vout"]]
            for addr in prev["scriptPubKey"].get("addresses", []):
                for a in self.s["attestors"]:
                    if self.node(a["node"]).validateaddress(addr).get("ismine"):
                        owners.add(a["index"])
        return sorted(owners)

    def scenario_demo(self, attestors, activation, base_port, anvil_port, interval, block_time, keep, timeout):
        started = datetime.datetime.now(datetime.timezone.utc)
        self.say("=== hawkeye-devnet scenario demo (plan §8 D-1 + D-2), %s" % started.strftime("%Y-%m-%d %H:%M:%S UTC"))
        ycashd = self.binaries()[0]
        if ycashd:
            self.say("ycashd: %s" % run_cmd([ycashd, "-version"], check=False).stdout.splitlines()[0])
        hk = self.binaries()[2]
        self.say("hawkeye: %s (%s)" % (hk, run_cmd([hk, "--version"], check=False).stdout.strip() if os.access(hk, os.X_OK) else "missing"))
        ok = False
        try:
            self.say("--- step 1: up")
            self.up(attestors, activation, base_port, anvil_port, interval, block_time)
            if not self.hawkeye_has("run"):
                die("the hawkeye binary has no `run` subcommand: the demo needs the sidecars (devnet/README.md)")
            dep = self.deployment()
            token, holder = dep["token"], self.s["holder"]["eth_address"]
            set_id = self.s["set"]["setid"]

            self.say("--- step 2: lock 10 YEC on node0 to the holder %s" % holder)
            lk = self.lock("10", holder)
            if lk.get("txid"):
                self.wait_for("lock %s confirmed" % lk["txid"][:16],
                              lambda: self.node(0).getrawtransaction(lk["txid"], 1).get("confirmations", 0) >= 1, timeout)

            self.say("--- step 3: wait for the mint (wYEC.balanceOf(holder) == 10e8)")
            self.wait_for("holder holds 10 wYEC",
                          lambda: int(self.eth_call(token, "balanceOf(address)(uint256)", holder)) == 10 * COIN, timeout)
            self.say("  wYEC totalSupply %s" % yec(int(self.eth_call(token, "totalSupply()(uint256)"))))

            recipient = self.node(0).getnewaddress()
            spk = self.node(0).validateaddress(recipient)["scriptPubKey"]
            rhash = hashlib.sha256(bytes.fromhex(spk)).hexdigest()
            self.say("--- step 4: burn 4 wYEC to node0's %s (recipientHash %s..)" % (recipient, rhash[:16]))
            before = {r["outpoint"] for r in self.intents()}
            self.burn("4", recipient)

            self.say("--- step 5: wait for the intent carrying the HKB1 memo")

            def burn_intent():
                for r in self.intents():
                    if r["outpoint"] in before or r["recipienthash"] != rhash or r["valuezat"] != 4 * COIN:
                        continue
                    memo = self.memo_of(r["txid"])
                    if memo and memo["kind"] == 1:
                        return r, memo
                return None
            row, memo = self.wait_for("intent paying 4 YEC to the burn recipient, with an HKB1 kind-1 memo", burn_intent, timeout)
            self.say("  intent %s: memo chainId %d bridge %s nonce %d burn tx 0x%s; matures at %s"
                     % (row["outpoint"], memo["chainid"], memo["bridge"], memo["ref"], memo["data"], row["matureheight"]))
            if memo["chainid"] != 31337 or memo["bridge"].lower() != dep["bridge"].lower():
                die("memo names another deployment: %s" % memo)

            self.say("--- step 6: wait for the release (node0 receives 4 YEC at %s)" % recipient)
            self.wait_for("4 YEC received at %s" % recipient,
                          lambda: Decimal(self.node(0).getreceivedbyaddress(recipient, 1)) == 4, timeout + 60)

            self.say("--- step 7: rogue 1 YEC by attestor1 (an unlock with no burn behind it)")
            from_h = self.tip()
            before = {r["outpoint"] for r in self.intents()}
            rg = self.rogue("1", 1)
            if not rg.get("intent"):
                def new_intent():
                    mem = list(self.node(0).getrawmempool())
                    for r in self.intents():
                        if r["outpoint"] not in before and r["recipienthash"] != rhash:
                            return r["outpoint"]
                    for t in mem:
                        tx = self.node(0).getrawtransaction(t, 1)
                        for o in tx["vout"]:
                            if self.node(0).vault_decodescript(o["scriptPubKey"]["hex"]).get("type") == "intent" \
                                    and not self.memo_of(t):
                                return "%s:%d" % (t, o["n"])
                    return None
                rg["intent"] = self.wait_for("the rogue intent appears", new_intent, 60)
            self.say("  rogue intent %s" % rg["intent"])

            self.say("--- step 8: wait for the cancel by another attestor (intent spent back into a vault)")

            def cancelled():
                sp = self.spender_of(rg["intent"], from_h)
                if not sp:
                    return None
                t, tx = sp
                types = [self.node(0).vault_decodescript(o["scriptPubKey"]["hex"]).get("type") for o in tx["vout"]]
                if "vault" not in types:
                    die("the rogue intent %s was spent by %s, which is not a cancel (outputs %s)" % (rg["intent"], t, types))
                return t, tx
            ctxid, ctx = self.wait_for("rogue intent cancelled", cancelled, timeout)
            by = self.owner_of_inputs(ctx)
            self.say("  cancel %s funded by attestor%s" % (ctxid, ",".join(map(str, by)) or "?"))
            if 1 in by:
                die("the cancel was funded by attestor1, the rogue itself")
            self.wait_for("cancel confirmed", lambda: self.node(0).getrawtransaction(ctxid, 1).get("confirmations", 0) >= 1, 120)

            self.say("--- step 9: wait for the slash (attestor1 removed, bond frozen)")
            key1 = self.s["attestors"][0]["memberkey"]

            def slashed():
                for m in self.node(0).set_getinfo(set_id)["memberlist"]:
                    if m["key"] == key1 and m["status"] == "removed" and m["bondfrozen"]:
                        return m
                return None
            m = self.wait_for("attestor1 status removed, bondfrozen true", slashed, timeout + 120)
            self.say("  member %s..: %s" % (key1[:16], jdump(m)))

            self.say("--- step 10: the supply invariant")
            supply = int(self.eth_call(token, "totalSupply()(uint256)"))
            rows = self.node(0).vault_list({"tag": "WYEC", "setid": set_id})
            locked = sum(r["valuezat"] for r in rows)
            self.say("  wYEC totalSupply %s <= WYEC value under the set %s (%d vaults, %d intents)"
                     % (yec(supply), yec(locked), sum(r["kind"] == "vault" for r in rows), sum(r["kind"] == "intent" for r in rows)))
            if supply > locked:
                die("supply invariant broken")
            if supply != 6 * COIN:
                die("totalSupply %s, expected 6" % yec(supply))
            st = self.status()
            for k, v in st["hawkeye"].items():
                self.say("  %s status: %s" % (k, json.dumps(v, default=str)[:300]))
            ok = True
            self.say("=== PASS: lock -> mint, burn -> intent (HKB1) -> release, rogue -> cancel -> slash, invariant holds")
        except DevnetError as error:
            self.say("=== FAIL: %s" % error)
        finally:
            if not keep and self.load(required=False):
                try:
                    self.say("--- down")
                    self.down()
                except Exception as error:
                    self.say("down: %s" % error)
            name = "demo-%s.txt" % started.strftime("%Y-%m-%d")
            target = TRANSCRIPTS if ok else self.path("transcripts")
            os.makedirs(target, exist_ok=True)
            out = os.path.join(target, name if ok else name.replace(".txt", "-FAILED.txt"))
            with open(out, "w") as f:
                f.write("\n".join(self.lines) + "\n")
            print("transcript: %s" % out)
        return 0 if ok else 1

    # ================================================================ scenario roll
    def scenario_roll(self, attestors, activation, base_port, anvil_port, interval, block_time, keep, timeout):
        """Drill D-13 (plan §3.1 HK-6): a vault near its ownerHeight is rolled into a fresh V with a later
        ownerHeight by the roll leader (kind-2 memo), not cancelled by the watchers, and released into the new
        vault after the delay. The drill shortens the horizons: MIN_OWNER_AGE 20, ROLL_MARGIN 40, and the
        rolled lock is written with ownerHeight 30 above the tip (policy-OK, already within the margin)."""
        started = datetime.datetime.now(datetime.timezone.utc)
        self.say("=== hawkeye-devnet scenario roll (plan §8 D-13, HK-6), %s" % started.strftime("%Y-%m-%d %H:%M:%S UTC"))
        ycashd = self.binaries()[0]
        if ycashd:
            self.say("ycashd: %s" % run_cmd([ycashd, "-version"], check=False).stdout.splitlines()[0])
        ok = False
        overrides = {"min_owner_age": 20, "roll_margin": 40}
        try:
            self.say("--- step 1: up with MIN_OWNER_AGE %(min_owner_age)d, ROLL_MARGIN %(roll_margin)d" % overrides)
            self.up(attestors, activation, base_port, anvil_port, interval, block_time, bridge=overrides)
            if not self.hawkeye_has("run"):
                die("the hawkeye binary has no `run` subcommand: the drill needs the sidecars")
            dep = self.deployment()
            token, holder = dep["token"], self.s["holder"]["eth_address"]
            set_id = self.s["set"]["setid"]
            n0 = self.node(0)

            self.say("--- step 2: lock 10 YEC with ownerHeight 400 above the tip (far from due) and wait for its mint")
            self.lock("10", holder, owner_age=400)
            self.wait_for("holder holds 10 wYEC",
                          lambda: int(self.eth_call(token, "balanceOf(address)(uint256)", holder)) == 10 * COIN, timeout)

            self.say("--- step 3: lock 2 YEC with ownerHeight 30 above the tip (policy-OK: >= 20; due: <= 40)")
            from_h = self.tip()
            lk = self.lock("2", holder, owner_age=30)
            txid = lk.get("txid")
            if not txid:
                die("the lock printed no txid: %s" % lk)
            outpoint = "%s:0" % txid
            self.wait_for("lock %s confirmed" % txid[:16],
                          lambda: n0.getrawtransaction(txid, 1).get("confirmations", 0) >= 1, timeout)
            old = n0.vault_decodescript(n0.getrawtransaction(txid, 1)["vout"][0]["scriptPubKey"]["hex"])
            self.say("  vault %s: ownerHeight %d (tip %d)" % (outpoint, old["ownerheight"], self.tip()))
            self.wait_for("holder holds 12 wYEC (the short lock is minted too)",
                          lambda: int(self.eth_call(token, "balanceOf(address)(uint256)", holder)) == 12 * COIN, timeout)

            self.say("--- step 4: wait for the roll: the vault unlocked into a fresh V, with an HKB1 kind-2 memo")

            def rolled():
                sp = self.spender_of(outpoint, from_h)
                if not sp:
                    return None
                t, tx = sp
                memo = None
                intent = None
                for o in tx["vout"]:
                    memo = memo or decode_memo(o["scriptPubKey"]["hex"])
                    d = n0.vault_decodescript(o["scriptPubKey"]["hex"])
                    if d.get("type") == "intent":
                        intent = (o, d)
                if not memo or memo["kind"] != 2 or not intent:
                    die("vault %s was spent by %s, which is not a roll (memo %s)" % (outpoint, t, memo))
                return t, memo, intent
            rtxid, memo, (iout, idec) = self.wait_for("roll unlock of %s" % outpoint, rolled, timeout)
            self.say("  roll %s: memo ref (new ownerHeight) %d, data %s.., intent %s:%d of %s YEC, recipientHash %s.."
                     % (rtxid, memo["ref"], memo["data"][:16], rtxid, iout["n"], iout["value"], idec["recipienthash"][:16]))
            if memo["ref"] <= old["ownerheight"]:
                die("the roll does not extend ownerHeight (%d <= %d)" % (memo["ref"], old["ownerheight"]))
            if memo["data"] != idec["recipienthash"]:
                die("memo data %s != the intent's recipientHash %s" % (memo["data"], idec["recipienthash"]))
            if memo["chainid"] != 31337 or memo["bridge"].lower() != dep["bridge"].lower():
                die("memo names another deployment: %s" % memo)
            by = self.owner_of_inputs(n0.getrawtransaction(rtxid, 1))
            self.say("  roll funded by attestor%s" % ",".join(map(str, by)))

            self.say("--- step 5: wait for the release into the new vault (not a cancel)")
            intent = "%s:%d" % (rtxid, iout["n"])

            def released():
                sp = self.spender_of(intent, from_h)
                if not sp:
                    return None
                t, tx = sp
                for o in tx["vout"]:
                    d = n0.vault_decodescript(o["scriptPubKey"]["hex"])
                    if d.get("type") == "vault":
                        if d["ownerheight"] != memo["ref"]:
                            die("the roll intent was spent back into ownerHeight %d: cancelled, not released"
                                % d["ownerheight"])
                        if n0.getrawtransaction(t, 1).get("confirmations", 0) < 1:
                            return None
                        return t, o, d
                die("the roll intent was spent by %s without a vault output" % t)
            reltxid, vout, vdec = self.wait_for("roll intent released into a V with ownerHeight %d" % memo["ref"],
                                                released, timeout + 60)
            self.say("  release %s: new vault %s:%d, %s YEC, ownerHeight %d (was %d)"
                     % (reltxid, reltxid, vout["n"], vout["value"], vdec["ownerheight"], old["ownerheight"]))
            rows = n0.vault_list({"tag": "WYEC", "setid": set_id, "kind": "vault"})
            if not any(r["outpoint"] == "%s:%d" % (reltxid, vout["n"]) and r["valuezat"] == 2 * COIN for r in rows):
                die("the new vault is not in vault_list: %s" % jdump(rows))

            self.say("--- step 6: nobody was slashed; the supply invariant holds")
            members = n0.set_getinfo(set_id)["memberlist"]
            if any(m["status"] != "active" for m in members):
                die("a member lost its seat: %s" % jdump(members))
            supply = int(self.eth_call(token, "totalSupply()(uint256)"))
            locked = sum(r["valuezat"] for r in n0.vault_list({"tag": "WYEC", "setid": set_id}))
            self.say("  wYEC totalSupply %s <= WYEC value under the set %s" % (yec(supply), yec(locked)))
            if supply > locked or supply != 12 * COIN:
                die("supply invariant broken (supply %s, locked %s)" % (yec(supply), yec(locked)))
            st = self.status()
            for k, v in st["hawkeye"].items():
                self.say("  %s status: %s" % (k, json.dumps(v, default=str)[:300]))
            ok = True
            self.say("=== PASS: vault near ownerHeight rolled (kind-2 memo) into a later V, released, not cancelled")
        except DevnetError as error:
            self.say("=== FAIL: %s" % error)
        finally:
            if not keep and self.load(required=False):
                try:
                    self.say("--- down")
                    self.down()
                except Exception as error:
                    self.say("down: %s" % error)
            name = "roll-%s.txt" % started.strftime("%Y-%m-%d")
            target = TRANSCRIPTS if ok else self.path("transcripts")
            os.makedirs(target, exist_ok=True)
            out = os.path.join(target, name if ok else name.replace(".txt", "-FAILED.txt"))
            with open(out, "w") as f:
                f.write("\n".join(self.lines) + "\n")
            print("transcript: %s" % out)
        return 0 if ok else 1


# ====================================================================== CLI

def main():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)        # `hawkeye-devnet logs | head`
    parser = argparse.ArgumentParser(prog="hawkeye-devnet", description=__doc__.split("\n")[0],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--dir", default=argparse.SUPPRESS,
                        help="run directory (default $HAWKEYE_DEVNET_DIR or devnet/run)")
    parser.add_argument("--dir", default=argparse.SUPPRESS, help="run directory (default $HAWKEYE_DEVNET_DIR or devnet/run)")
    sub = parser.add_subparsers(dest="command", required=True)
    _add = sub.add_parser
    sub.add_parser = lambda *a, **kw: _add(*a, parents=[common], **kw)

    def up_args(p):
        p.add_argument("--attestors", type=int, default=3)
        p.add_argument("--activation", type=int, default=110, help="UPGRADE_VAULT height (default 110)")
        p.add_argument("--base-port", type=int, default=18400, help="node i: p2p base+2i, rpc base+2i+1")
        p.add_argument("--anvil-port", type=int, default=18545)
        p.add_argument("--interval", type=float, default=2.0, help="background miner: seconds per block (0: off)")
        p.add_argument("--block-time", type=int, default=1, help="anvil block time in seconds (0: automine)")

    up_args(sub.add_parser("up", help="start the devnet (or resume a stopped one)"))
    p = sub.add_parser("lock", help="node0 locks YEC under the set (to the holder by default)")
    p.add_argument("amount")
    p.add_argument("--dest")
    p.add_argument("--owner-age", type=int, help="ownerHeight - tip (default MIN_OWNER_AGE + ROLL_MARGIN + 10)")
    p = sub.add_parser("burn", help="the holder burns wYEC to a Ycash t-address (node0's by default)")
    p.add_argument("amount")
    p.add_argument("--recipient")
    p = sub.add_parser("rogue", help="attestor1 signs an unlock with no burn (drill D-2)")
    p.add_argument("amount")
    p.add_argument("--attestor", type=int, default=1)
    sub.add_parser("silence", help="stop attestor N's hawkeye").add_argument("n", type=int)
    sub.add_parser("unsilence", help="start attestor N's hawkeye again").add_argument("n", type=int)
    sub.add_parser("mine", help="node0 mines N blocks now").add_argument("n", type=int)
    sub.add_parser("heartbeat", help="every attestor node sends SET_HEARTBEAT (by hand, when the sidecars are not running)")
    sub.add_parser("pause", help="pause the background miner")
    sub.add_parser("resume", help="resume the background miner")
    sub.add_parser("status").add_argument("--json", action="store_true")
    p = sub.add_parser("logs", help="tail every log (node debug.log, anvil, hawkeye, miner)")
    p.add_argument("-n", type=int, default=20)
    p.add_argument("-f", "--follow", action="store_true")
    p = sub.add_parser("cli", help="ycash-cli against node I: cli I METHOD [ARGS...]")
    p.add_argument("i", type=int)
    p.add_argument("args", nargs=argparse.REMAINDER)
    sub.add_parser("down", help="stop everything, keep the directory")
    sub.add_parser("clean", help="remove the (stopped) run directory")
    p = sub.add_parser("scenario", help="scripted end-to-end scenarios")
    p.add_argument("name", choices=["demo", "roll"])
    up_args(p)
    p.add_argument("--keep", action="store_true", help="leave the devnet up afterwards")
    p.add_argument("--fresh", action="store_true", help="clean a stopped devnet in --dir first")
    p.add_argument("--timeout", type=int, default=180, help="seconds per wait step")
    sub.add_parser("_miner")
    args = parser.parse_args()

    dv = Devnet(getattr(args, "dir", None) or os.environ.get("HAWKEYE_DEVNET_DIR") or DEFAULT_DIR)
    try:
        if args.command == "up":
            dv.up(args.attestors, args.activation, args.base_port, args.anvil_port, args.interval, args.block_time)
        elif args.command == "lock":
            dv.lock(args.amount, args.dest, args.owner_age)
        elif args.command == "burn":
            dv.burn(args.amount, args.recipient)
        elif args.command == "rogue":
            dv.rogue(args.amount, args.attestor)
        elif args.command in ("silence", "unsilence"):
            dv.silence(args.n, args.command == "silence")
        elif args.command == "mine":
            dv.load()
            dv.mine(args.n)
            dv.say("mined %d; height %d" % (args.n, dv.tip()))
        elif args.command == "heartbeat":
            dv.heartbeat()
        elif args.command in ("pause", "resume"):
            dv.pause(args.command == "pause")
        elif args.command == "status":
            st = dv.status()
            if args.json:
                print(json.dumps(st, indent=2, default=str))
            else:
                dv.print_status(st)
        elif args.command == "logs":
            dv.logs(args.n, args.follow)
        elif args.command == "cli":
            s = dv.load()
            cli = s["binaries"].get("ycash_cli") or "ycash-cli"
            nd = s["nodes"][args.i]
            os.execvp(cli, [cli, "-datadir=%s" % nd["datadir"]] + args.args)
        elif args.command == "down":
            dv.down()
        elif args.command == "clean":
            dv.clean()
        elif args.command == "scenario":
            if dv.load(required=False) is not None:
                if dv.running():
                    die("a devnet is up in %s; `down` (and `clean`) first, or use another --dir" % dv.dir)
                if not args.fresh:
                    die("%s holds a stopped devnet; the demo starts from a fresh one: `clean` first or pass --fresh" % dv.dir)
                dv.clean()
                dv.s = None
            run = dv.scenario_roll if args.name == "roll" else dv.scenario_demo
            return run(args.attestors, args.activation, args.base_port, args.anvil_port, args.interval,
                       args.block_time, args.keep, args.timeout)
        elif args.command == "_miner":
            dv.miner_loop()
    except DevnetError as error:
        print("hawkeye-devnet: %s" % error, file=sys.stderr)
        return 1
    except RPCError as error:
        print("hawkeye-devnet: RPC error: %s" % error, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
