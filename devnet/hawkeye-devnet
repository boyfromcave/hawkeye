                  % (st["height"], "active" if v.get("active") else "inactive", v.get("activationheight"), v.get("sets"),
                     v.get("vaults"), v.get("intents"), v.get("lockedvalue")))
        if "set" in st:
            s = st["set"]
            print("  set %s: current %s/%s, dormant %s, released %s, lockedvalue %s, epoch %s used %s available %s"
                  % (s["setid"], s["current"], s["members"], s["dormant"], s["released"], s["lockedvalue"], s["epoch"],
                     s["epochused"], s.get("unlockavailable")))
            for m in st["members"]:
                print("    attestor%s %s.. %s current=%s live=%s lastact=%s bondfrozen=%s"
                      % (m["attestor"], m["key"][:16], m["status"], m["current"], m["live"], m["lastact"], m["bondfrozen"]))
            for r in st["vaults"]:
                print("    vault  %s %s YEC (height %s)" % (r["outpoint"], r["value"], r["height"]))
            for r in st["intents"]:
                print("    intent %s %s YEC mature=%s cancellable=%s" % (r["outpoint"], r["value"], r["mature"], r["cancellable"]))
        if "eth" in st:
            e = st["eth"]
            print("  eth: block %d (finalized %d), wYEC totalSupply %s, holder %s balance %s; supply invariant %s"
