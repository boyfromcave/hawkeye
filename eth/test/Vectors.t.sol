// SPDX-License-Identifier: MIT
pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {Vm} from "forge-std/Vm.sol";
import {stdStorage, StdStorage} from "forge-std/StdStorage.sol";
import {ECDSA} from "@openzeppelin/contracts/utils/cryptography/ECDSA.sol";
import {WrappedYcash} from "wyec/WrappedYcash.sol";
import {IWrappedYcash, WyecBridge} from "wyec/WyecBridge.sol";
import {WyecEip712} from "wyec-test/utils/WyecEip712.sol";

/// Generates (WRITE_VECTORS=true) or checks (default) vectors/eip712.json: EIP-712 domain
/// separators, struct hashes, digests and signatures for fixed keys and inputs, consumed by
/// hawkeye-core and hawkeye-eth (plan §4.4, §7). Every signing case is also *accepted by the pinned
/// WyecBridge*: the test deploys the bridge at the case's verifyingContract on the case's chain id
/// with the case's signer as a 1-of-1 guardian and submits the signature (a Challenge case against
/// a proposal given the case's proposalId). Format: vectors/README.md.
///
/// Negative cases (`"expectAccepted": false`, audit 05/T-4) are *refused* by the pinned WyecBridge
/// with the exact error the case names (a wrong chain id or verifying contract, high-S, a bad `v`,
/// a duplicate or non-ascending signer list, a Challenge signature submitted as a Mint); the Rust
/// consumers assert their own rejection of the same bytes.
///
/// The `wyecCommit` stamp is the fetched pin (vendor/wyec/.wyec-commit, written by
/// tools/fetch-wyec.sh), never a constant here: a re-pin without regenerating fails this test
/// (audit 05/T-1).
///
///   WRITE_VECTORS=true forge test --mc Eip712VectorsTest     # regenerate
contract Eip712VectorsTest is Test {
    using stdStorage for StdStorage;

    string constant PATH = "vectors/eip712.json";
    string constant PIN_FILE = "vendor/wyec/.wyec-commit";
    address constant BRIDGE = 0x5FbDB2315678afecb367f032d93F642f64180aa3; // anvil's first CREATE
    address constant NEW_BRIDGE = 0x00000000000000000000000000000000DeaDBeef;
    /// The secp256k1 group order.
    uint256 constant N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141;

    uint256[3] internal pks;
    uint256[2] internal chainIds = [uint256(31337), uint256(11155111)];
    string[] internal cases;

    function setUp() public {
        for (uint256 i = 0; i < 3; i++) {
            pks[i] = uint256(keccak256(abi.encodePacked("hawkeye/eip712-vector-key/", vm.toString(i))));
        }
    }

    function test_Eip712Vectors() public {
        for (uint256 c = 0; c < chainIds.length; c++) {
            uint256 cid = chainIds[c];
            domainCase(cid);
            for (uint256 m = 0; m < 3; m++) {
                (bytes32 lockId, uint256 amount, address to) = mintInput(m);
                for (uint256 k = 0; k < 3; k++) {
                    mintCase(cid, k, lockId, amount, to);
                }
            }
            address[] memory g = new address[](3);
            g[0] = vm.addr(pks[2]);
            g[1] = vm.addr(pks[0]);
            g[2] = vm.addr(pks[1]);
            setGuardiansCase(cid, 0, g, 2, 0);
            setGuardiansCase(cid, 0, g, 3, 5);
            setPausedCase(cid, 1, true, 0);
            setPausedCase(cid, 1, false, 1);
            setBridgeCase(cid, 2, NEW_BRIDGE, 3);
            setMintLimitCase(cid, 0, 1000e8, 86400, 2);
            setMintLimitCase(cid, 1, 0, 0, 7);
            for (uint256 m = 0; m < 3; m++) {
                (bytes32 lockId,,) = mintInput(m);
                challengeCase(cid, m, lockId, challengeId(m));
            }
        }
        negativeCases();

        string memory body = "";
        for (uint256 i = 0; i < cases.length; i++) {
            body = string.concat(body, i == 0 ? "\n    " : ",\n    ", cases[i]);
        }
        string memory pin = vm.trim(vm.readFile(PIN_FILE));
        assertEq(
            bytes(pin).length, 40, "vendor/wyec/.wyec-commit is not a commit hash: run tools/fetch-wyec.sh"
        );
        string memory json = string.concat(
            "{\n",
            '  "description": "wYEC EIP-712 vectors: generated by eth/test/Vectors.t.sol; every expectAccepted case accepted by WyecBridge, every other refused with its named error",\n',
            '  "wyecCommit": "',
            pin,
            '",\n',
            '  "cases": [',
            body,
            "\n  ]\n}\n"
        );

        if (vm.envOr("WRITE_VECTORS", false)) {
            vm.writeFile(PATH, json);
        } else {
            // The stamp first, so a stale pin says so rather than "the file differs".
            assertEq(
                vm.parseJsonString(vm.readFile(PATH), ".wyecCommit"),
                pin,
                "vectors stamp does not match the fetched pin: WRITE_VECTORS=true forge test --mc Eip712VectorsTest"
            );
            assertEq(
                vm.readFile(PATH),
                json,
                "vectors/eip712.json is stale: WRITE_VECTORS=true forge test --mc Eip712VectorsTest"
            );
        }
    }

    // ------------------------------------------------------------------ inputs

    function mintInput(uint256 m) internal pure returns (bytes32 lockId, uint256 amount, address to) {
        if (m == 0) {
            // lockId = sha256(txid_internal || vout u32 LE) (plan §4.1), txid 0x11..11, vout 0
            lockId = sha256(
                abi.encodePacked(
                    bytes32(0x1111111111111111111111111111111111111111111111111111111111111111), bytes4(0)
                )
            );
            return (lockId, 1e8, 0x1111111111111111111111111111111111111111);
        }
        if (m == 1) {
            // vout 1 (LE 01000000), the 21M cap in zatoshi
            lockId = sha256(
                abi.encodePacked(
                    bytes32(0xabababababababababababababababababababababababababababababababab),
                    bytes4(0x01000000)
                )
            );
            return (lockId, 21_000_000 * 1e8, 0xabCDeF0123456789AbcdEf0123456789aBCDEF01);
        }
        return (bytes32(type(uint256).max), 1, 0x0000000000000000000000000000000000000001);
    }

    /// Proposal ids: the first ever, an ordinary one, and the largest a uint96 counter reaches.
    function challengeId(uint256 m) internal pure returns (uint256) {
        if (m == 0) return 1;
        if (m == 1) return 42;
        return type(uint96).max;
    }

    // ------------------------------------------------------------------ cases

    function domainCase(uint256 cid) internal {
        uint256 snap = vm.snapshotState();
        bytes32 ds = WyecEip712.domainSeparator(cid, BRIDGE);
        // The contract's own view of its domain must agree.
        WyecBridge b = deployAt(cid, vm.addr(pks[0]));
        (, string memory name, string memory version, uint256 chainId, address vc,,) = b.eip712Domain();
        assertEq(keccak256(bytes(name)), keccak256("WyecBridge"));
        assertEq(keccak256(bytes(version)), keccak256("1"));
        assertEq(chainId, cid);
        assertEq(vc, BRIDGE);
        string memory entry = string.concat(
            '{"kind": "Domain", ',
            head(cid),
            ', "name": "WyecBridge", "version": "1", "digest": "',
            vm.toString(ds),
            '"}'
        );
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    function mintCase(uint256 cid, uint256 k, bytes32 lockId, uint256 amount, address to) internal {
        uint256 snap = vm.snapshotState();
        bytes32 sh = WyecEip712.mintStruct(lockId, amount, to);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(cid, BRIDGE), sh);
        bytes memory sig = signLowS(pks[k], d);
        WyecBridge b = deployAt(cid, vm.addr(pks[k]));
        b.mint(lockId, amount, to, one(sig));
        assertEq(WrappedYcash(address(b.token())).balanceOf(to), amount);
        string memory fields = string.concat(
            '"lockId": "',
            vm.toString(lockId),
            '", "amount": "',
            vm.toString(amount),
            '", "to": "',
            vm.toString(to)
        );
        string memory t = tail(sh, d, k, sig);
        string memory entry = string.concat('{"kind": "Mint", ', head(cid), ", ", fields, '", ', t, "}");
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    function setGuardiansCase(uint256 cid, uint256 k, address[] memory g, uint8 threshold, uint256 adminNonce)
        internal
    {
        uint256 snap = vm.snapshotState();
        bytes32 sh = WyecEip712.setGuardiansStruct(g, threshold, adminNonce);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(cid, BRIDGE), sh);
        bytes memory sig = signLowS(pks[k], d);
        WyecBridge b = deployAt(cid, vm.addr(pks[k]));
        setAdminNonce(b, adminNonce);
        b.setGuardians(g, threshold, one(sig));
        assertEq(b.threshold(), threshold);
        assertEq(b.adminNonce(), adminNonce + 1);
        string memory entry = string.concat(
            '{"kind": "SetGuardians", ',
            head(cid),
            ", ",
            guardiansFields(g, threshold, adminNonce),
            ", ",
            tail(sh, d, k, sig),
            "}"
        );
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    function setPausedCase(uint256 cid, uint256 k, bool paused, uint256 adminNonce) internal {
        uint256 snap = vm.snapshotState();
        bytes32 sh = WyecEip712.setPausedStruct(paused, adminNonce);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(cid, BRIDGE), sh);
        bytes memory sig = signLowS(pks[k], d);
        WyecBridge b = deployAt(cid, vm.addr(pks[k]));
        setAdminNonce(b, adminNonce);
        // Pausable reverts on a no-op (ExpectedPause / EnforcedPause): start from the other state.
        if (!paused) stdstore.target(address(b)).sig("paused()").checked_write(true);
        b.setPaused(paused, one(sig));
        assertEq(b.paused(), paused);
        string memory t = tail(sh, d, k, sig);
        string memory entry = string.concat(
            '{"kind": "SetPaused", ',
            head(cid),
            ', "paused": ',
            paused ? "true" : "false",
            ', "adminNonce": "',
            vm.toString(adminNonce),
            '", ',
            t,
            "}"
        );
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    function setBridgeCase(uint256 cid, uint256 k, address newBridge, uint256 adminNonce) internal {
        uint256 snap = vm.snapshotState();
        bytes32 sh = WyecEip712.setBridgeStruct(newBridge, adminNonce);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(cid, BRIDGE), sh);
        bytes memory sig = signLowS(pks[k], d);
        WyecBridge b = deployAt(cid, vm.addr(pks[k]));
        setAdminNonce(b, adminNonce);
        // setBridge refuses an EOA (BadSuccessor). The recorded address stays newBridge; the stub
        // deployed there bridges this token and reads this bridge as predecessor.
        deployCodeTo(
            "Vectors.t.sol:SetBridgeSuccessorStub", abi.encode(address(b.token()), address(b)), newBridge
        );
        b.setBridge(newBridge, one(sig));
        assertEq(WrappedYcash(address(b.token())).bridge(), newBridge);
        string memory t = tail(sh, d, k, sig);
        string memory entry = string.concat(
            '{"kind": "SetBridge", ',
            head(cid),
            ', "newBridge": "',
            vm.toString(newBridge),
            '", "adminNonce": "',
            vm.toString(adminNonce),
            '", ',
            t,
            "}"
        );
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    function setMintLimitCase(uint256 cid, uint256 k, uint256 cap, uint256 window, uint256 adminNonce)
        internal
    {
        uint256 snap = vm.snapshotState();
        bytes32 sh = WyecEip712.setMintLimitStruct(cap, window, adminNonce);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(cid, BRIDGE), sh);
        bytes memory sig = signLowS(pks[k], d);
        WyecBridge b = deployAt(cid, vm.addr(pks[k]));
        setAdminNonce(b, adminNonce);
        b.setMintLimit(cap, window, one(sig));
        assertEq(b.mintCap(), cap);
        assertEq(b.capWindow(), window);
        assertEq(b.adminNonce(), adminNonce + 1);
        string memory t = tail(sh, d, k, sig);
        string memory entry = string.concat(
            '{"kind": "SetMintLimit", ',
            head(cid),
            ', "mintCap": "',
            vm.toString(cap),
            '", "capWindow": "',
            vm.toString(window),
            '", "adminNonce": "',
            vm.toString(adminNonce),
            '", ',
            t,
            "}"
        );
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    /// The challenge is submitted against a real proposal with the case's id: the counter is set
    /// to id - 1, the signer proposes (amount 1 to 0x..01), then challenges with the case's
    /// signature.
    function challengeCase(uint256 cid, uint256 k, bytes32 lockId, uint256 proposalId) internal {
        uint256 snap = vm.snapshotState();
        bytes32 sh = WyecEip712.challengeStruct(lockId, proposalId);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(cid, BRIDGE), sh);
        bytes memory sig = signLowS(pks[k], d);
        submitChallenge(cid, k, lockId, proposalId, sig);
        string memory t = tail(sh, d, k, sig);
        string memory entry = string.concat(
            '{"kind": "Challenge", ',
            head(cid),
            ', "lockId": "',
            vm.toString(lockId),
            '", "proposalId": "',
            vm.toString(proposalId),
            '", ',
            t,
            "}"
        );
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    // ------------------------------------------------------------------ negative cases

    /// Every case is submitted on chain 31337 to the bridge at BRIDGE; the Mint is input 0.
    /// Single-signature cases go through `proposeMint` (a 1-of-1 set of the signer), list cases
    /// through the threshold `mint` (the three keys, threshold 2).
    function negativeCases() internal {
        // A signature over another domain recovers, over this one, to a non-guardian.
        wrongDomainCase("wrong-chain-id", 11155111, BRIDGE);
        wrongDomainCase("wrong-verifying-contract", 31337, NEW_BRIDGE);
        malleatedCase("high-s");
        malleatedCase("bad-v");
        wrongStructCase();
        signerListCase("duplicate-signer");
        signerListCase("not-ascending");
    }

    function mintFields(bytes32 lockId, uint256 amount, address to) internal pure returns (string memory) {
        return string.concat(
            '"lockId": "',
            vm.toString(lockId),
            '", "amount": "',
            vm.toString(amount),
            '", "to": "',
            vm.toString(to),
            '"'
        );
    }

    function wrongDomainCase(string memory reject, uint256 signedCid, address signedVc) internal {
        uint256 snap = vm.snapshotState();
        (bytes32 lockId, uint256 amount, address to) = mintInput(0);
        bytes32 sh = WyecEip712.mintStruct(lockId, amount, to);
        bytes32 signedD = WyecEip712.digest(WyecEip712.domainSeparator(signedCid, signedVc), sh);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(31337, BRIDGE), sh);
        bytes memory sig = signLowS(pks[0], signedD);
        address recovered = refusedAsNotGuardian(lockId, amount, to, d, sig);
        string memory signedAs = string.concat(
            '"signedChainId": ',
            vm.toString(signedCid),
            ', "signedVerifyingContract": "',
            vm.toString(signedVc),
            '", "signedDigest": "',
            vm.toString(signedD),
            '"'
        );
        string memory entry =
            notGuardianEntry(reject, lockId, amount, to, signedAs, tail(sh, d, 0, sig), recovered);
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    /// Submits `sig` through `proposeMint` on a 1-of-1 set of key 0 and expects NotGuardian(r), r
    /// the address it recovers to over the contract's digest `d`.
    function refusedAsNotGuardian(bytes32 lockId, uint256 amount, address to, bytes32 d, bytes memory sig)
        internal
        returns (address recovered)
    {
        recovered = ECDSA.recover(d, sig);
        assertTrue(recovered != vm.addr(pks[0]));
        WyecBridge b = deployAt(31337, vm.addr(pks[0]));
        vm.expectRevert(abi.encodeWithSelector(WyecBridge.NotGuardian.selector, recovered));
        b.proposeMint(lockId, amount, to, sig);
    }

    function notGuardianEntry(
        string memory reject,
        bytes32 lockId,
        uint256 amount,
        address to,
        string memory signedAs,
        string memory t,
        address recovered
    ) internal pure returns (string memory) {
        return string.concat(
            '{"kind": "Mint", ',
            negHead(reject),
            ", ",
            mintFields(lockId, amount, to),
            ", ",
            signedAs,
            ", ",
            t,
            ', "recovered": "',
            vm.toString(recovered),
            '", "revert": "NotGuardian(address)"}'
        );
    }

    /// `high-s`: (r, n - s, v flipped), the same point's other signature; `bad-v`: v - 27 (0 or 1).
    function malleatedCase(string memory reject) internal {
        uint256 snap = vm.snapshotState();
        (bytes32 lockId, uint256 amount, address to) = mintInput(0);
        bytes32 sh = WyecEip712.mintStruct(lockId, amount, to);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(31337, BRIDGE), sh);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(pks[0], d);
        bytes memory sig;
        bytes memory err;
        string memory revertName;
        if (keccak256(bytes(reject)) == keccak256("high-s")) {
            bytes32 highS = bytes32(N - uint256(s));
            sig = abi.encodePacked(r, highS, v == 27 ? uint8(28) : uint8(27));
            err = abi.encodeWithSelector(ECDSA.ECDSAInvalidSignatureS.selector, highS);
            revertName = "ECDSAInvalidSignatureS(bytes32)";
        } else {
            sig = abi.encodePacked(r, s, v - 27);
            err = abi.encodeWithSelector(ECDSA.ECDSAInvalidSignature.selector);
            revertName = "ECDSAInvalidSignature()";
        }
        WyecBridge b = deployAt(31337, vm.addr(pks[0]));
        vm.expectRevert(err);
        b.proposeMint(lockId, amount, to, sig);
        string memory entry = string.concat(
            '{"kind": "Mint", ',
            negHead(reject),
            ", ",
            mintFields(lockId, amount, to),
            ", ",
            tail(sh, d, 0, sig),
            ', "revert": "',
            revertName,
            '"}'
        );
        vm.revertToState(snap);
        cases.push(entry);
    }

    /// A guardian's Challenge signature (lockId, proposal 1) submitted as the Mint of that lockId.
    function wrongStructCase() internal {
        uint256 snap = vm.snapshotState();
        (bytes32 lockId, uint256 amount, address to) = mintInput(0);
        bytes32 sh = WyecEip712.mintStruct(lockId, amount, to);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(31337, BRIDGE), sh);
        bytes32 signedD = WyecEip712.digest(
            WyecEip712.domainSeparator(31337, BRIDGE), WyecEip712.challengeStruct(lockId, 1)
        );
        bytes memory sig = signLowS(pks[0], signedD);
        address recovered = refusedAsNotGuardian(lockId, amount, to, d, sig);
        string memory signedAs = string.concat(
            '"signedKind": "Challenge", "signedProposalId": "1", "signedDigest": "', vm.toString(signedD), '"'
        );
        string memory entry =
            notGuardianEntry("wrong-struct", lockId, amount, to, signedAs, tail(sh, d, 0, sig), recovered);
        vm.revertToState(snap); // forget the throwaway deployment, keep the entry
        cases.push(entry);
    }

    /// `duplicate-signer`: [a, a]; `not-ascending`: the two lowest-address keys' signatures in
    /// descending signer order, accepted once sorted (`acceptedAfterSort`).
    function signerListCase(string memory reject) internal {
        uint256 snap = vm.snapshotState();
        (bytes32 lockId, uint256 amount, address to) = mintInput(0);
        bytes32 sh = WyecEip712.mintStruct(lockId, amount, to);
        bytes32 d = WyecEip712.digest(WyecEip712.domainSeparator(31337, BRIDGE), sh);
        (uint256 lo, uint256 hi) = vm.addr(pks[0]) < vm.addr(pks[1]) ? (pks[0], pks[1]) : (pks[1], pks[0]);
        bool dup = keccak256(bytes(reject)) == keccak256("duplicate-signer");
        bytes[] memory sigs = new bytes[](2);
        if (dup) {
            sigs[0] = signLowS(lo, d);
            sigs[1] = sigs[0];
        } else {
            sigs[0] = signLowS(hi, d);
            sigs[1] = signLowS(lo, d);
        }
        WyecBridge b = deployAt3(31337);
        vm.expectRevert(WyecBridge.SignersNotAscending.selector);
        b.mint(lockId, amount, to, sigs);
        if (!dup) {
            bytes[] memory sorted = new bytes[](2);
            (sorted[0], sorted[1]) = (sigs[1], sigs[0]);
            b.mint(lockId, amount, to, sorted);
            assertEq(WrappedYcash(address(b.token())).balanceOf(to), amount);
        }
        string memory entry = string.concat(
            '{"kind": "Mint", ',
            negHead(reject),
            ", ",
            mintFields(lockId, amount, to),
            ', "structHash": "',
            vm.toString(sh),
            '", "digest": "',
            vm.toString(d),
            '", "signers": ["',
            vm.toString(vm.addr(dup ? lo : hi)),
            '", "',
            vm.toString(vm.addr(lo)),
            '"], "signatures": ["',
            vm.toString(sigs[0]),
            '", "',
            vm.toString(sigs[1]),
            '"], "acceptedAfterSort": ',
            dup ? "false" : "true",
            ', "revert": "SignersNotAscending()"}'
        );
        vm.revertToState(snap);
        cases.push(entry);
    }

    // ------------------------------------------------------------------ helpers

    function submitChallenge(uint256 cid, uint256 k, bytes32 lockId, uint256 proposalId, bytes memory sig)
        internal
    {
        WyecBridge b = deployAt(cid, vm.addr(pks[k]));
        stdstore.target(address(b)).sig("proposalCount()").checked_write(proposalId - 1);
        bytes32 md = WyecEip712.digest(
            WyecEip712.domainSeparator(cid, BRIDGE), WyecEip712.mintStruct(lockId, 1, address(1))
        );
        assertEq(b.proposeMint(lockId, 1, address(1), signLowS(pks[k], md)), proposalId);
        b.challengeMint(lockId, proposalId, sig);
        assertEq(b.getProposal(lockId).id, 0);
        assertTrue(b.vetoed(lockId, vm.addr(pks[k])));
    }

    function guardiansFields(address[] memory g, uint8 threshold, uint256 adminNonce)
        internal
        pure
        returns (string memory list)
    {
        for (uint256 i = 0; i < g.length; i++) {
            list = string.concat(list, i == 0 ? '"' : ', "', vm.toString(g[i]), '"');
        }
        return string.concat(
            '"guardians": [',
            list,
            '], "threshold": ',
            vm.toString(uint256(threshold)),
            ', "adminNonce": "',
            vm.toString(adminNonce),
            '"'
        );
    }

    function head(uint256 cid) internal pure returns (string memory) {
        return string.concat(
            '"chainId": ',
            vm.toString(cid),
            ', "verifyingContract": "',
            vm.toString(BRIDGE),
            '", "expectAccepted": true'
        );
    }

    /// A refused case: the domain it is *submitted* under, and why it must be refused.
    function negHead(string memory reject) internal pure returns (string memory) {
        return string.concat(
            '"chainId": 31337, "verifyingContract": "',
            vm.toString(BRIDGE),
            '", "expectAccepted": false, "reject": "',
            reject,
            '"'
        );
    }

    function tail(bytes32 structHash, bytes32 d, uint256 k, bytes memory sig)
        internal
        returns (string memory)
    {
        Vm.Wallet memory w = vm.createWallet(pks[k]);
        bytes memory pub =
            abi.encodePacked(bytes1(w.publicKeyY % 2 == 0 ? 0x02 : 0x03), bytes32(w.publicKeyX));
        return string.concat(
            '"structHash": "',
            vm.toString(structHash),
            '", "digest": "',
            vm.toString(d),
            '", "privateKey": "',
            vm.toString(bytes32(pks[k])),
            '", "publicKey": "',
            vm.toString(pub),
            '", "signer": "',
            vm.toString(w.addr),
            '", "signature": "',
            vm.toString(sig),
            '"'
        );
    }

    function signLowS(uint256 pk, bytes32 d) internal pure returns (bytes memory) {
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(pk, d);
        require(uint256(s) <= N / 2, "high-S");
        return abi.encodePacked(r, s, v);
    }

    function one(bytes memory sig) internal pure returns (bytes[] memory sigs) {
        sigs = new bytes[](1);
        sigs[0] = sig;
    }

    /// A fresh token + bridge with the bridge at BRIDGE on chain `cid`, `guardian` as 1-of-1, a
    /// 60-second challenge window, no rate limit.
    function deployAt(uint256 cid, address guardian) internal returns (WyecBridge) {
        vm.chainId(cid);
        WrappedYcash t = new WrappedYcash(BRIDGE);
        address[] memory g = new address[](1);
        g[0] = guardian;
        deployCodeTo(
            "WyecBridge.sol:WyecBridge",
            abi.encode(t, g, uint8(1), uint64(60), uint256(0), uint256(0), uint256(0), address(0)),
            BRIDGE
        );
        return WyecBridge(BRIDGE);
    }

    /// As deployAt, with the three vector keys as guardians and threshold 2.
    function deployAt3(uint256 cid) internal returns (WyecBridge) {
        vm.chainId(cid);
        WrappedYcash t = new WrappedYcash(BRIDGE);
        address[] memory g = new address[](3);
        for (uint256 i = 0; i < 3; i++) {
            g[i] = vm.addr(pks[i]);
        }
        deployCodeTo(
            "WyecBridge.sol:WyecBridge",
            abi.encode(t, g, uint8(2), uint64(60), uint256(0), uint256(0), uint256(0), address(0)),
            BRIDGE
        );
        return WyecBridge(BRIDGE);
    }

    function setAdminNonce(WyecBridge b, uint256 n) internal {
        if (n != 0) stdstore.target(address(b)).sig("adminNonce()").checked_write(n);
        assertEq(b.adminNonce(), n);
    }
}

/// What `setBridge` accepts as a successor: code, this token, and this bridge as `predecessor`.
contract SetBridgeSuccessorStub {
    address public immutable token;
    address public immutable predecessor;

    constructor(address token_, address predecessor_) {
        token = token_;
        predecessor = predecessor_;
    }
}
